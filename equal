#include <bits/stdc++.h>
using namespace std;

bool canPartitionGrid(vector<vector<int>>& grid) {
    int m = grid.size(), n = grid[0].size();
    
    long long total = 0;
    unordered_map<int, int> freq;
    
    // total sum + frequency
    for (auto &row : grid) {
        for (int x : row) {
            total += x;
            freq[x]++;
        }
    }
    
    // ---------- Horizontal cuts ----------
    long long top = 0;
    unordered_map<int, int> topFreq;
    
    for (int i = 0; i < m - 1; i++) {
        for (int j = 0; j < n; j++) {
            top += grid[i][j];
            topFreq[grid[i][j]]++;
            freq[grid[i][j]]--;
            if (freq[grid[i][j]] == 0) freq.erase(grid[i][j]);
        }
        
        long long bottom = total - top;
        
        if (top == bottom) return true;
        
        long long diff = abs(top - bottom);
        
        if (top > bottom) {
            if (topFreq.count(diff)) return true;
        } else {
            if (freq.count(diff)) return true;
        }
    }
    
    // ---------- Vertical cuts ----------
    vector<long long> colSum(n, 0);
    for (int j = 0; j < n; j++) {
        for (int i = 0; i < m; i++) {
            colSum[j] += grid[i][j];
        }
    }
    
    long long left = 0;
    unordered_map<int, int> leftFreq;
    
    // rebuild freq
    freq.clear();
    for (auto &row : grid)
        for (int x : row)
            freq[x]++;
    
    for (int j = 0; j < n - 1; j++) {
        for (int i = 0; i < m; i++) {
            left += grid[i][j];
            leftFreq[grid[i][j]]++;
            freq[grid[i][j]]--;
            if (freq[grid[i][j]] == 0) freq.erase(grid[i][j]);
        }
        
        long long right = total - left;
        
        if (left == right) return true;
        
        long long diff = abs(left - right);
        
        if (left > right) {
            if (leftFreq.count(diff)) return true;
        } else {
            if (freq.count(diff)) return true;
        }
    }
    
    return false;
}

int main()
{

    vector<vector<int>>g = {{1,4}, {2,3}};
    cout<<(solve(g)?"True": " False")<<endl;
}